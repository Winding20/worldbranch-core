    "scenario": {
      "role": "唐廷 · 天宝十四载",
      "goal": "在叛乱中保住社稷：不失两京，不让藩镇坐大，不让天下崩解。",
      "briefing": "天宝十四载十一月，范阳、平卢、河东三镇节度使安禄山以「清君侧」为名起兵，率十五万众南下。承平四十年的天下，一时竟无可用之兵。朝廷要在仓促间决定：守哪里、用谁、信谁。八年之后这段历史会写下结局——而这一次，你可以改写它。",
      "pressures": [
        "安禄山拥三镇之兵，河北州县望风而降",
        "朝廷精锐多在边镇，京畿空虚",
        "杨国忠与安禄山势同水火，朝议激烈"
      ],
      "watch": [
        "洛阳是否失守",
        "潼关守军",
        "朔方军动向",
        "府库与人心"
      ]
    }
